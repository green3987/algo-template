// 模板来源 https://leetcode.cn/discuss/post/3583665/
// 最大堆 LazyHeap<int> max_pq;
// 最小堆 LazyHeap<int, greater<>> min_pq;
//template<typename T> 里的 typename
//它在这里的作用只是声明"T 是一个类型参数"
template<typename T,typename Compare=less<T>>//这是个有两个模板参数的模板。模板参数可以有任意多个，用逗号分隔
class LasyHeap
{
    priority_queue<T,vector<T>,Compare>pq;
    unordered_map<T,int>remove_cnt;//每个元素剩余需要删除的次数
    size_t sz=0;//实际大小

    //正式删除操作
    void apply_remove(){
        while(!pq.empty()&&remove_cnt[pq.top()]>0)
        {
            remove_cnt[pq.top()]--;
            pq.pop();
        }
    }
public:
    size_t size()
    {
        return sz;
    }

    //删除
    void remove(T x)
    {
        remove_cnt[x]++;//懒删除
        sz--;
    }

    //查看堆顶
    T top()
    {
        apply_remove();//清除僵尸元素 本该删的却还在堆里的无效元素
        return pq.top();
    }

    //出堆
    T pop()
    {
        apply_remove();//同理
        sz--;
        T x=pq.top();
        pq.pop();//这个是标准库的函数 并没有在递归
        return x;
    }

    //入堆
    void push(T x)
    {
        pq.push(x);
        sz++;
    }

    //push(x)然后pop()
    T push_pop(T x)
    {
        if(sz>0&&Compare()(x,top()))//x比堆顶更优 直接替换
        {
            pq.push(x);
            x=pq.top();
            pq.pop();
        }
        return x;
    }
};
